{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coreweaverlabs.com/agents/geo-audit.schema.json",
  "title": "Coreweaver GEO Audit v2 configuration",
  "type": "object",
  "required": ["version", "target", "paths", "runner"],
  "properties": {
    "version": {"type": "string", "pattern": "^2\\.0$"},
    "target": {
      "type": "object",
      "required": ["id", "displayName", "origin", "homepage", "entity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "displayName": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "format": "uri"},
        "homepage": {"type": "string", "format": "uri"},
        "entity": {
          "type": "object",
          "required": ["canonicalName", "qualifiers"],
          "properties": {
            "canonicalName": {"type": "string", "minLength": 1},
            "qualifiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "required": ["robots", "sitemap", "llms"],
      "additionalProperties": {"type": "string", "pattern": "^/"}
    },
    "expectations": {
      "type": "object",
      "properties": {
        "homepageSchemaTypes": {"type": "array", "items": {"type": "string"}},
        "entityCues": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "required": ["timeoutMs", "maxBodyBytes", "userAgent"],
      "properties": {
        "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 60000},
        "maxBodyBytes": {"type": "integer", "minimum": 1024, "maximum": 5000000},
        "userAgent": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
