{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coreweaver Research Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "capturedAt", "source", "observations"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "publisher", "sourceClass", "checkedOn", "limitation"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "sourceClass": { "enum": ["first_party", "official_guidance", "market_source", "keyword_provider"] },
        "checkedOn": { "type": "string", "format": "date" },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "readerQuestion", "statement", "evidenceClass"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "readerQuestion": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "evidenceClass": { "enum": ["first_party_fact", "third_party_fact", "interpretation", "proposal"] },
          "timeSensitive": { "type": "boolean", "default": false },
          "recheckBy": { "type": ["string", "null"], "format": "date" }
        }
      }
    }
  }
}
