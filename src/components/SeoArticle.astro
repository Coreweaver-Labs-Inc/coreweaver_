---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  heading: string;
  lede: string;
  section: string;
  image?: string;
  imageAlt?: string;
  imageCaption?: string;
  dateModified?: string;
  type?: 'Article' | 'DefinedTerm';
  termCode?: string;
}

const { title, description, canonical, eyebrow, heading, lede, section, image, imageAlt, imageCaption, dateModified = '2026-08-17', type = 'Article', termCode } = Astro.props;
const authorUrl = 'https://www.linkedin.com/in/mason-nguyen';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': type,
      '@id': `${canonical}#article`,
      name: heading,
      headline: heading,
      description,
      url: canonical,
      dateModified,
      inLanguage: 'en-US',
      author: { '@type': 'Person', '@id': `${authorUrl}#person`, name: 'Mason Nguyen', url: authorUrl, sameAs: [authorUrl, 'https://github.com/Coreweaver-Labs-Inc'] },
      publisher: { '@type': 'Organization', name: 'Coreweaver Labs', url: 'https://coreweaverlabs.com/' },
      ...(type === 'DefinedTerm' ? { termCode, inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Coreweaver Labs GEO glossary', url: 'https://coreweaverlabs.com/geo/' } } : {}),
      ...(image ? { image: new URL(image, 'https://coreweaverlabs.com').href } : {}),
      isPartOf: { '@type': 'WebSite', name: 'Coreweaver Labs', url: 'https://coreweaverlabs.com/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coreweaverlabs.com/' },
        { '@type': 'ListItem', position: 2, name: section, item: canonical },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} schema={schema} ogImage={image} ogImageAlt={imageAlt ?? heading}>
  <article class="seo-article">
    <div class="container narrow">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={section === 'GEO' ? '/geo/' : section === 'AI Mastery' ? '/ai-mastery/' : '/geo-compass/'}>{section}</a><span aria-hidden="true">/</span><span aria-current="page">{heading}</span></nav>
      <div class="section-eyebrow">{eyebrow}</div>
      <h1 class="article-title">{heading}</h1>
      <p class="article-lede">{lede}</p>
      <div class="byline">By <a href={authorUrl} rel="author">Mason Nguyen</a> · Coreweaver Labs · Updated {dateModified}</div>
      {image && <figure class="seo-figure"><img src={image} alt={imageAlt ?? heading} width="1200" height="675" loading="eager" decoding="async" /><figcaption>{imageCaption}</figcaption></figure>}
      <div class="content-body"><slot /></div>
    </div>
  </article>
</Layout>
