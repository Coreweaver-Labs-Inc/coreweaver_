---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  canonical?: string;
  schema?: object;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  canonical = Astro.url.href,
  schema,
} = Astro.props;

const fullTitle = title.includes('Coreweaver') ? title : `${title} — Coreweaver Labs`;
const year = new Date().getFullYear();
const defaultImage = '/coreweaver-labs-logo-2026.png';
const imagePath = ogImage === '/og-default.png' ? defaultImage : ogImage;
const imageUrl = imagePath.startsWith('http') ? imagePath : new URL(imagePath, Astro.url.origin).href;
const imageAlt = ogImageAlt ?? `${fullTitle} social preview`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#090c12" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="llms-txt" href="/llms.txt" />
    <link rel="icon" href="/coreweaver-labs-logo-2026.png" type="image/png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Coreweaver Labs" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <meta name="base:app_id" content="6a1834c7660a3f727dea7030" />
    <meta name="base:app_id" content="6a0ada777abfff0aca7b16f5" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient ambient--teal" aria-hidden="true"></div>
    <div class="ambient ambient--brass" aria-hidden="true"></div>

    <header class="site-header">
      <div class="shell header__inner">
        <a class="brand" href="/" aria-label="Coreweaver Labs home">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 20 20 9l11 11-11 11L9 20Z" stroke="currentColor" stroke-width="1.5" />
              <path d="m20 9 11 11-11 11" stroke="currentColor" stroke-width="1.5" opacity=".45" />
              <circle cx="20" cy="20" r="3" fill="currentColor" />
            </svg>
          </span>
          <span class="brand__type"><strong>COREWEAVER</strong><small>LABS / 001</small></span>
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/#system">System</a>
          <a href="/#method">Method</a>
          <a href="/autonomous-resource-management">ARM</a>
          <a href="/blog">Notes</a>
          <a href="/mandate">Principles</a>
          <a href="/vaas">Limits</a>
          <a href="/source-map">Sources</a>
        </nav>

        <a class="button button--small button--outline header__cta" href="mailto:hello@coreweaverlabs.com?subject=Coreweaver%20working%20session">Start a session <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer__top">
        <div>
          <div class="footer__label">COREWEAVER LABS / GROWTH INFRASTRUCTURE</div>
          <p class="footer__statement">Make the organization clearer before asking the market to pay attention.</p>
        </div>
        <div class="footer__links" aria-label="Footer links">
          <a href="/blog">Field notes</a>
          <a href="/mandate">Working principles</a>
          <a href="/vaas">Verification limits</a>
          <a href="/source-map">Source map</a>
          <a href="https://github.com/Coreweaver-Labs-Inc/coreweaver_">Source</a>
          <a href="mailto:hello@coreweaverlabs.com">Contact</a>
        </div>
      </div>
      <div class="shell footer__bottom">
        <span>© {year} Coreweaver Labs</span>
        <span>ENTITY · EVIDENCE · DISTRIBUTION · MEASUREMENT</span>
      </div>
    </footer>
  </body>
</html>
