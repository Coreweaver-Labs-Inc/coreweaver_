---
import Layout from '../layouts/Layout.astro';

/**
 * DESIGN SYSTEM: Signal Observatory, adapted for an energy operating field.
 * Use the Coreweaver obsidian surface, mineral-aqua signal language, warm brass
 * constraint markers, editorial type, and asymmetric information panels.
 */
const applicationFields = [
  {
    code: '01',
    label: 'Distributed resources',
    title: 'Coordination across changing assets',
    description: 'Generation, storage, flexible load, vehicles, buildings, and their signals can make the condition surrounding a decision harder to reconstruct.',
    route: 'Signal boundary → action scope → record',
  },
  {
    code: '02',
    label: 'Microgrid conditions',
    title: 'Interruption changes the route',
    description: 'Isolation, lost communications, reconnection, and local constraints make it necessary to name what has changed before a prior decision path resumes.',
    route: 'Checkpoint → escalation → review',
  },
  {
    code: '03',
    label: 'Operations control',
    title: 'Authority must travel with the decision',
    description: 'A system recommendation, a bounded action, and an operator-approved directive are different routes and should not be treated as interchangeable.',
    route: 'Mandate → owner → intervention',
  },
  {
    code: '04',
    label: 'Operating evidence',
    title: 'The record is part of the action',
    description: 'A useful review state retains the constraint, allowed evidence, action boundary, exception path, and named owner without manufacturing certainty.',
    route: 'Condition → evidence → retained record',
  },
];

const controls = [
  ['Mandate chain', 'What human-approved directive permits this category of action?'],
  ['Signal architecture', 'Which observations are allowed to influence the decision?'],
  ['Checkpoint recovery', 'What decision state survives an interruption?'],
  ['Graceful escalation', 'When does the operating route return to a person?'],
  ['Audit sovereignty', 'What remains available for later review?'],
];

const sources = [
  {
    title: 'Autonomous Energy Systems',
    publisher: 'National Laboratory of the Rockies',
    url: 'https://www.nlr.gov/grid/autonomous-energy',
    note: 'Public context on heterogeneous energy resources, real-time operations, disturbance tolerance, and interoperability.',
  },
  {
    title: 'Autonomous, decentralized microgrid control',
    publisher: 'U.S. Department of Energy',
    url: 'https://www.energy.gov/oe/articles/demonstrating-benefits-autonomous-decentralized-control-microgrids',
    note: 'Public context on locally available information and coordination through a change in system condition.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Autonomous Operations for Energy Systems',
  description: 'A Coreweaver Labs application page for examining authority, signals, exceptions, and retained records around energy-system decisions.',
  url: 'https://coreweaverlabs.com/autonomous-operations-energy-systems',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Coreweaver Labs',
    url: 'https://coreweaverlabs.com/',
  },
  about: {
    '@type': 'Thing',
    name: 'Autonomous operations for energy systems',
    description: 'A decision-infrastructure view of energy-system operations under changing constraints and human oversight.',
  },
};
---

<!-- DESIGN SYSTEM: Signal Observatory. This route uses a field-notebook composition to connect energy operating conditions to ARM decision primitives. -->
<Layout
  title="Autonomous Operations for Energy Systems"
  description="A Coreweaver Labs application page for examining authority, signals, exceptions, and retained records around energy-system decisions."
  canonical="https://coreweaverlabs.com/autonomous-operations-energy-systems"
  schema={schema}
>
  <section class="energy-hero">
    <div class="energy-hero__grid" aria-hidden="true"></div>
    <div class="energy-hero__arc energy-hero__arc--one" aria-hidden="true"></div>
    <div class="energy-hero__arc energy-hero__arc--two" aria-hidden="true"></div>
    <div class="shell energy-hero__inner">
      <div class="energy-hero__copy">
        <p class="eyebrow reveal">Applied method / energy operations</p>
        <h1 class="energy-hero__title reveal reveal--2">Make the energy decision <em>inspectable.</em></h1>
        <p class="energy-hero__lead reveal reveal--3">Autonomous operations for energy systems begin where conditions, authority, evidence, and intervention have to meet in the same operating route.</p>
        <div class="energy-hero__actions reveal reveal--3">
          <a class="button button--lime" href="#operating-route">Inspect an operating route <span aria-hidden="true">↓</span></a>
          <a class="energy-link" href="/autonomous-resource-management#primitives">Examine ARM primitives <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="field-console reveal reveal--2" aria-label="Energy operations field note">
        <div class="field-console__topline"><span>ENERGY / OPERATING FIELD</span><span class="field-console__status">LIVE CONDITION</span></div>
        <div class="field-console__body">
          <p class="field-console__label">THE DECISION ROUTE</p>
          <p class="field-console__title">A condition is not an authority. An observation is not an action.</p>
          <dl class="field-console__metrics">
            <div><dt>Condition</dt><dd>Variable</dd></div>
            <div><dt>Authority</dt><dd>Named</dd></div>
            <div><dt>Action</dt><dd>Bounded</dd></div>
            <div><dt>Record</dt><dd>Retained</dd></div>
          </dl>
        </div>
        <div class="field-console__footer"><span>NO PREDICTION</span><span>OPERATING POSITION</span></div>
      </aside>
    </div>
    <div class="shell energy-hero__foot" aria-label="Page classification">
      <span>COREWEAVER LABS / APPLIED METHOD</span><span>CONSTRAINT → AUTHORITY → ACTION → RECORD</span><span>ENERGY 01</span>
    </div>
  </section>

  <section class="section energy-intro">
    <div class="shell energy-intro__grid">
      <div>
        <p class="eyebrow">01 / The operating condition</p>
        <h2 class="section-title">More coordination needs a <em>clearer handoff.</em></h2>
      </div>
      <div class="energy-intro__copy">
        <p class="body-large">Energy-system decisions can involve heterogeneous resources, changing communications conditions, time-sensitive signals, and human operating responsibility. The question is not whether every condition can be predicted. It is whether the operating route remains <strong>visible when the condition changes.</strong></p>
        <p>Public research describes autonomous energy systems through coordination, real-time operations, disturbance tolerance, and interoperability. This page does not make a claim of technical performance or control. It uses that context to ask what must be named before an action is delegated.</p>
      </div>
    </div>
  </section>

  <section class="section section--paper energy-fields">
    <div class="shell">
      <div class="energy-section-head">
        <p class="eyebrow">02 / Application fields</p>
        <p class="energy-section-head__meta">AUTONOMY IS NOT A CATEGORY.<br />IT IS A DECISION ROUTE.</p>
      </div>
      <div class="field-grid">
        {applicationFields.map((field) => (
          <article class="field-card">
            <div class="field-card__top"><span>{field.code} / {field.label}</span><span class="field-card__tick" aria-hidden="true">↗</span></div>
            <h3>{field.title}</h3>
            <p>{field.description}</p>
            <div class="field-card__route"><span>ROUTE</span><span>{field.route}</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="operating-route" class="section energy-route">
    <div class="shell energy-route__intro">
      <div>
        <p class="eyebrow">03 / Inspect the route</p>
        <h2 class="section-title">Start with one recurring <em>decision.</em></h2>
      </div>
      <p class="body-large">Choose a decision that already carries operating pressure: a resource response, a change in mode, a remote action path, or an exception that returns to a person. Then make the route legible before treating it as delegable.</p>
    </div>
    <div class="shell route-ledger" role="list">
      <article class="route-ledger__row" role="listitem"><span>01</span><div><h3>Map the constraint</h3><p>State the operating condition, dependency, or limit that should shape the decision.</p></div><em>What must be true?</em></article>
      <article class="route-ledger__row" role="listitem"><span>02</span><div><h3>Name the authority</h3><p>Separate a human-approved directive, a system recommendation, and a bounded action.</p></div><em>Who may decide?</em></article>
      <article class="route-ledger__row" role="listitem"><span>03</span><div><h3>Bound the evidence</h3><p>Identify the observations that may influence the route and what happens when they are delayed, missing, or contradictory.</p></div><em>What may move it?</em></article>
      <article class="route-ledger__row" role="listitem"><span>04</span><div><h3>Keep the review state</h3><p>Retain the constraint, allowed evidence, action boundary, exception path, and accountable owner.</p></div><em>What remains?</em></article>
    </div>
  </section>

  <section class="section energy-controls">
    <div class="shell energy-controls__grid">
      <div class="energy-controls__copy">
        <p class="eyebrow">04 / The application layer</p>
        <h2 class="section-title">Five controls for a <em>decision-ready</em> operating field.</h2>
        <p class="body-large">Autonomous Resource Management gives the energy operating route a public vocabulary for authority, evidence, interruption, and review. It does not replace control design, operating procedures, cybersecurity practices, or accountable human judgment.</p>
        <a class="button button--outline" href="/autonomous-resource-management#primitives">Read the ARM framework <span aria-hidden="true">↗</span></a>
      </div>
      <div class="control-stack">
        {controls.map(([title, question], index) => (
          <a class="control-stack__item" href="/autonomous-resource-management#primitives">
            <span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{question}</p></div><b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper energy-sources">
    <div class="shell energy-sources__grid">
      <div>
        <p class="eyebrow">05 / Context, not proof</p>
        <h2 class="section-title">Public sources frame the field.<br /><em>They do not replace a record.</em></h2>
      </div>
      <div class="energy-sources__copy">
        <p>These public sources provide context on energy-system coordination and decentralized control. They do not authorize a claim that Coreweaver operates, optimizes, secures, certifies, or improves an energy system.</p>
        <a class="energy-link energy-link--ink" href="/source-map">Review Coreweaver sources <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="shell source-cards">
      {sources.map((source, index) => (
        <a class="source-card" href={source.url} rel="external">
          <span>{String(index + 1).padStart(2, '0')} / {source.publisher}</span>
          <h3>{source.title}</h3>
          <p>{source.note}</p>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="energy-bridge">
    <div class="shell energy-bridge__inner">
      <p class="eyebrow">06 / A working route</p>
      <h2>Bring one energy decision.<br /><em>Find the handoff.</em></h2>
      <p>Coreweaver starts with the decision already under pressure: the constraint, authority, evidence, intervention point, and record that should remain available when it matters.</p>
      <div class="energy-bridge__actions">
        <a class="button button--paper" href="mailto:hello@coreweaverlabs.com?subject=Energy%20operations%20working%20session">Map an operating decision <span aria-hidden="true">↗</span></a>
        <a class="energy-link energy-link--light" href="/autonomous-resource-management#primitives">Explore ARM primitives <span aria-hidden="true">↗</span></a>
      </div>
      <div class="energy-bridge__foot"><span>COREWEAVER LABS / ENERGY OPERATIONS</span><span>NO CLAIM IS A SUBSTITUTE FOR A RECORD.</span></div>
    </div>
  </section>
</Layout>

<style>
  /* SIGNAL OBSERVATORY / ENERGY FIELD: obsidian paper, mineral-aqua signal lines, brass constraint arcs, and asymmetric ledger panels. */
  .energy-hero { position: relative; z-index: 1; min-height: min(880px, calc(100svh - 76px)); overflow: hidden; border-bottom: 1px solid var(--line); background: #07090b; }
  .energy-hero::before { position: absolute; inset: 0; background: radial-gradient(circle at 75% 25%, rgba(20, 155, 162, .2), transparent 0 19%), radial-gradient(circle at 24% 78%, rgba(201, 140, 58, .12), transparent 0 22%); content: ''; pointer-events: none; }
  .energy-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(120, 215, 211, .065) 1px, transparent 1px), linear-gradient(90deg, rgba(120, 215, 211, .065) 1px, transparent 1px); background-size: clamp(48px, 6vw, 84px) clamp(48px, 6vw, 84px); mask-image: linear-gradient(to bottom, black, rgba(0,0,0,.7) 75%, transparent); pointer-events: none; }
  .energy-hero__arc { position: absolute; border: 1px solid rgba(201, 140, 58, .4); border-radius: 50%; pointer-events: none; }
  .energy-hero__arc--one { top: -32vw; right: -8vw; width: 69vw; aspect-ratio: 1; }
  .energy-hero__arc--two { right: 14vw; bottom: -35vw; width: 51vw; aspect-ratio: 1; border-color: rgba(120, 215, 211, .2); }
  .energy-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(340px, .68fr); align-items: center; gap: clamp(48px, 7vw, 132px); min-height: min(760px, calc(100svh - 112px)); padding: 112px 0 104px; }
  .energy-hero__copy { position: relative; z-index: 1; }
  .energy-hero__title { max-width: 9.8ch; margin: 19px 0 26px; font-size: clamp(59px, 8vw, 128px); font-weight: 700; letter-spacing: -.078em; line-height: .84; }
  .energy-hero__title em, .section-title em, .energy-bridge h2 em { color: var(--blue-bright); font-family: var(--font-serif); font-weight: 500; letter-spacing: -.08em; }
  .energy-hero__lead { max-width: 56ch; margin: 0; color: var(--text-muted); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.63; }
  .energy-hero__actions, .energy-bridge__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 17px; margin-top: 33px; }
  .energy-link { color: var(--blue-bright); font: 500 10px var(--font-mono); letter-spacing: .09em; text-decoration: none; text-transform: uppercase; transition: color 160ms var(--ease-out), transform 160ms var(--ease-out); }
  .energy-link:hover { color: var(--orange); transform: translateX(3px); }
  .field-console { position: relative; z-index: 1; border: 1px solid rgba(120, 215, 211, .46); background: rgba(8,15,17,.76); box-shadow: 22px 24px 0 rgba(20,155,162,.08); backdrop-filter: blur(12px); }
  .field-console::after { position: absolute; right: -1px; bottom: -1px; width: 95px; height: 2px; background: var(--orange); content: ''; }
  .field-console__topline, .field-console__footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 17px; color: var(--text-faint); font: 400 8px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .field-console__topline { border-bottom: 1px solid var(--line); }
  .field-console__status { color: var(--orange); }
  .field-console__body { padding: clamp(30px, 4vw, 46px) clamp(24px, 3vw, 40px) 31px; }
  .field-console__label { margin: 0 0 19px; color: var(--blue-bright); font: 400 8px var(--font-mono); letter-spacing: .11em; }
  .field-console__title { max-width: 23ch; margin: 0; color: var(--text); font: 500 clamp(21px, 2.3vw, 31px)/1.08 var(--font-serif); }
  .field-console__metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: 35px 0 0; background: rgba(120, 215, 211, .2); }
  .field-console__metrics div { min-height: 72px; padding: 13px; background: rgba(8,15,17,.82); }
  .field-console__metrics dt { color: var(--text-faint); font: 400 8px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .field-console__metrics dd { margin: 10px 0 0; color: var(--text); font-size: 15px; }
  .field-console__footer { border-top: 1px solid var(--line); color: var(--paper-muted); }
  .energy-hero__foot { position: absolute; z-index: 1; right: 0; bottom: 22px; left: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; color: var(--text-faint); font: 400 8px var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .energy-hero__foot span:nth-child(2) { color: var(--blue-bright); text-align: center; }
  .energy-hero__foot span:last-child { text-align: right; }
  .energy-intro__grid { display: grid; grid-template-columns: minmax(0,.9fr) minmax(320px,.75fr); gap: clamp(50px, 12vw, 210px); }
  .energy-intro__grid .section-title { margin-top: 23px; }
  .energy-intro__copy { max-width: 60ch; padding-top: 48px; }
  .energy-intro__copy p:not(.body-large) { margin: 22px 0 0; color: var(--text-faint); font: 400 11px/1.7 var(--font-mono); }
  .energy-section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; }
  .energy-section-head__meta { margin: 0; color: #536163; font: 400 9px/1.65 var(--font-mono); letter-spacing: .08em; text-align: right; }
  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin-top: 60px; border-top: 1px solid rgba(12,35,36,.18); border-left: 1px solid rgba(12,35,36,.18); }
  .field-card { display: flex; min-height: 350px; flex-direction: column; padding: 28px; border-right: 1px solid rgba(12,35,36,.18); border-bottom: 1px solid rgba(12,35,36,.18); background: linear-gradient(145deg, rgba(255,255,255,.32), transparent); }
  .field-card__top { display: flex; align-items: center; justify-content: space-between; color: #126f73; font: 400 9px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .field-card__tick { color: #b46f26; font-size: 14px; }
  .field-card h3 { max-width: 18ch; margin: clamp(48px, 5vw, 76px) 0 17px; color: var(--ink); font-size: clamp(24px, 2.2vw, 33px); letter-spacing: -.05em; line-height: 1; }
  .field-card p { max-width: 39ch; margin: 0; color: #5b6568; font-size: 14px; line-height: 1.65; }
  .field-card__route { display: flex; align-items: baseline; gap: 13px; margin-top: auto; padding-top: 29px; color: #126f73; font: 400 9px/1.5 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  .field-card__route span:first-child { color: #7a8484; font-size: 8px; }
  .energy-route { background: linear-gradient(125deg, rgba(20,155,162,.07), transparent 45%), var(--ink-raised); }
  .energy-route__intro { display: grid; grid-template-columns: minmax(0,.9fr) minmax(330px,.7fr); gap: clamp(48px,12vw,210px); align-items: end; }
  .energy-route__intro .section-title { margin-top: 22px; }
  .energy-route__intro .body-large { margin: 0; }
  .route-ledger { margin-top: 67px; border-top: 1px solid var(--line-strong); }
  .route-ledger__row { display: grid; grid-template-columns: 75px minmax(220px,.8fr) minmax(180px,.4fr); gap: 28px; align-items: start; padding: 30px 16px 31px 0; border-bottom: 1px solid var(--line); transition: background 180ms var(--ease-out), padding-left 180ms var(--ease-out); }
  .route-ledger__row:hover { padding-left: 18px; background: rgba(20,155,162,.08); }
  .route-ledger__row > span { color: var(--blue-bright); font: 400 10px var(--font-mono); letter-spacing: .1em; }
  .route-ledger__row h3 { margin: 0; color: var(--text); font-size: clamp(22px,2.3vw,32px); letter-spacing: -.05em; line-height: 1; }
  .route-ledger__row p { max-width: 46ch; margin: 10px 0 0; color: var(--text-muted); font-size: 14px; line-height: 1.65; }
  .route-ledger__row em { color: var(--orange); font: 400 9px/1.6 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .energy-controls__grid { display: grid; grid-template-columns: minmax(0,.85fr) minmax(350px,.75fr); gap: clamp(48px,12vw,205px); align-items: center; }
  .energy-controls__copy .section-title { margin-top: 22px; }
  .energy-controls__copy .body-large { margin: 27px 0 31px; }
  .control-stack { border-top: 1px solid var(--line-strong); }
  .control-stack__item { display: grid; grid-template-columns: 45px 1fr 20px; gap: 17px; padding: 21px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: padding 180ms var(--ease-out), background 180ms var(--ease-out); }
  .control-stack__item:hover { padding-right: 13px; padding-left: 13px; background: rgba(20,155,162,.08); }
  .control-stack__item > span { color: var(--blue-bright); font: 400 9px var(--font-mono); letter-spacing: .08em; }
  .control-stack__item h3 { margin: 0; color: var(--text); font-size: 20px; letter-spacing: -.035em; }
  .control-stack__item p { margin: 6px 0 0; color: var(--text-muted); font-size: 13px; line-height: 1.5; }
  .control-stack__item b { color: var(--orange); font-size: 14px; font-weight: 400; }
  .energy-sources__grid { display: grid; grid-template-columns: minmax(0,.9fr) minmax(330px,.68fr); gap: clamp(48px,12vw,210px); align-items: end; }
  .energy-sources__grid .section-title { margin-top: 22px; }
  .energy-sources__copy p { max-width: 51ch; margin: 0 0 24px; color: #566265; font-size: 15px; line-height: 1.68; }
  .energy-link--ink { color: #126f73; }
  .source-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 59px; }
  .source-card { position: relative; min-height: 260px; padding: 25px; border: 1px solid rgba(12,35,36,.18); background: rgba(255,255,255,.45); color: inherit; text-decoration: none; transition: transform 180ms var(--ease-out), border-color 180ms var(--ease-out); }
  .source-card:hover { border-color: #1b8181; transform: translateY(-4px); }
  .source-card > span { color: #126f73; font: 400 8px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .source-card h3 { max-width: 21ch; margin: 54px 0 14px; color: var(--ink); font-size: 27px; letter-spacing: -.05em; line-height: .98; }
  .source-card p { max-width: 44ch; margin: 0; color: #5b6568; font-size: 13px; line-height: 1.6; }
  .source-card b { position: absolute; right: 23px; bottom: 20px; color: #b46f26; font-size: 15px; font-weight: 400; }
  .energy-bridge { position: relative; z-index: 1; padding: clamp(86px,12vw,172px) 0 32px; overflow: hidden; background: var(--blue); color: #061012; }
  .energy-bridge::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(7,9,11,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(7,9,11,.14) 1px, transparent 1px); background-size: 64px 64px; content: ''; opacity: .8; pointer-events: none; }
  .energy-bridge__inner { position: relative; }
  .energy-bridge .eyebrow { color: #061012; }
  .energy-bridge .eyebrow::before { box-shadow: 0 0 0 3px rgba(7,9,11,.13); }
  .energy-bridge h2 { max-width: 13ch; margin: 25px 0 28px; font-size: clamp(43px,6.3vw,90px); letter-spacing: -.07em; line-height: .86; }
  .energy-bridge h2 em { color: var(--paper); }
  .energy-bridge p:not(.eyebrow) { max-width: 60ch; margin: 0; color: rgba(6,16,18,.8); font-size: clamp(16px,1.55vw,20px); line-height: 1.62; }
  .energy-link--light { color: #061012; }
  .energy-link--light:hover { color: var(--paper); }
