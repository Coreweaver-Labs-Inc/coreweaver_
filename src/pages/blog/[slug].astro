---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, getPostContent } from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map(post => ({ params: { slug: post.slug }, props: { post, allPosts: posts } }));
}

const { post, allPosts } = Astro.props;
const content = await getPostContent(post.id);
const relatedPosts = allPosts.filter(item => item.slug !== post.slug && item.category.some(category => post.category.includes(category))).slice(0, 2);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.metaDescription,
  datePublished: post.publishDate || undefined,
  dateModified: post.publishDate || undefined,
  publisher: { '@type': 'Organization', name: 'Coreweaver Labs', url: 'https://coreweaverlabs.com' },
  image: post.ogImageUrl ?? post.heroImageUrl ?? undefined,
  url: `https://coreweaverlabs.com/blog/${post.slug}`,
  mainEntityOfPage: `https://coreweaverlabs.com/blog/${post.slug}`,
};
---

<Layout title={post.title} description={post.metaDescription} ogImage={post.ogImageUrl ?? post.heroImageUrl ?? '/og-default.png'} ogType="article" schema={schema}>
  <article class="article">
    <div class="article__head shell">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Coreweaver</a><span>/</span><a href="/blog">Field notes</a><span>/</span><span aria-current="page">{post.title.slice(0, 34)}{post.title.length > 34 ? '…' : ''}</span></nav>
      <div class="article__categories">{post.category.map(category => <span>{category}</span>)}</div>
      <h1>{post.title}</h1>
      <div class="article__meta"><span>NOTE</span>{post.publishDate && <time datetime={new Date(post.publishDate).toISOString()}>{new Date(post.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>}{post.readingTime && <span>{post.readingTime} read</span>}</div>
      <p class="article__scope">This note should be read within its stated source, date, and scope. It is not a certification, a performance claim, or a substitute for independent verification.</p>
    </div>
    {post.heroImageUrl && <div class="shell article__image"><img src={post.heroImageUrl} alt="" loading="eager" width="1200" height="630" /></div>}
    <div class="shell article__body prose-coreweaver" set:html={content} />
    {relatedPosts.length > 0 && <aside class="shell related"><p>Continue reading</p><div>{relatedPosts.map(related => <a href={`/blog/${related.slug}`}><span>{related.category[0] || 'Note'}</span><strong>{related.title}</strong><small>Read the note ↗</small></a>)}</div></aside>}
    <div class="shell article__foot"><a href="/blog">← Back to field notes</a><span>COREWEAVER / SOURCE-AWARE NOTES</span></div>
  </article>
</Layout>

<style>
  .article{position:relative;z-index:1;padding:72px 0 110px}.article__head{max-width:900px}.crumbs{display:flex;flex-wrap:wrap;gap:8px;color:var(--text-faint);font:400 9px var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.crumbs a{color:var(--text-muted);text-decoration:none}.crumbs a:hover{color:var(--orange)}.article__categories{display:flex;flex-wrap:wrap;gap:6px;margin-top:48px}.article__categories span{border:1px solid rgba(201,140,58,.42);padding:3px 7px;color:var(--lime);font:400 8px var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.article h1{max-width:15ch;margin:20px 0 26px;font-size:clamp(48px,7vw,100px);letter-spacing:-.075em;line-height:.87}.article__meta{display:flex;flex-wrap:wrap;gap:11px;color:var(--text-faint);font:400 9px var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.article__meta span:first-child{color:var(--blue-bright)}.article__scope{max-width:55ch;margin:34px 0 0;border-left:1px solid var(--line-strong);padding-left:15px;color:var(--text-muted);font-size:13px;line-height:1.65}.article__image{max-width:1130px;margin-top:56px}.article__image img{display:block;width:100%;aspect-ratio:16/8;object-fit:cover;border:1px solid var(--line)}.article__body{max-width:780px;margin-top:62px}.prose-coreweaver{color:var(--text-muted);font-size:17px;line-height:1.82}.prose-coreweaver :global(h2){margin:2.8em 0 .75em;color:var(--text);font-size:36px;letter-spacing:-.05em;line-height:1.05}.prose-coreweaver :global(h3){margin:2em 0 .7em;color:var(--text);font-size:22px;letter-spacing:-.04em}.prose-coreweaver :global(p){margin:0 0 1.35em}.prose-coreweaver :global(a){color:var(--blue-bright);text-underline-offset:4px}.prose-coreweaver :global(strong){color:var(--text)}.prose-coreweaver :global(ul),.prose-coreweaver :global(ol){padding-left:1.4em;margin:0 0 1.3em}.prose-coreweaver :global(li){margin-bottom:.45em}.prose-coreweaver :global(blockquote){margin:2em 0;border-left:2px solid var(--lime);padding-left:20px;color:var(--text);font:500 25px/1.3 var(--font-serif)}.prose-coreweaver :global(pre){overflow:auto;background:var(--ink-raised);border:1px solid var(--line);padding:20px}.prose-coreweaver :global(img){max-width:100%;height:auto}.related{max-width:1130px;margin-top:84px;padding-top:24px;border-top:1px solid var(--line)}.related>p{color:var(--text-faint);font:400 9px var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.related>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;margin-top:18px;border:1px solid var(--line)}.related a{display:grid;min-height:180px;align-content:start;background:rgba(13,19,22,.32);padding:20px;text-decoration:none;transition:background 160ms var(--ease-out)}.related a:hover{background:rgba(20,155,162,.12)}.related a span,.related a small{color:var(--lime);font:400 8px var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.related a strong{margin:42px 0 16px;color:var(--text);font-size:22px;letter-spacing:-.05em;line-height:1.05}.related a small{color:var(--blue-bright)}.article__foot{display:flex;justify-content:space-between;gap:20px;margin-top:54px;border-top:1px solid var(--line);padding-top:20px;color:var(--text-faint);font:400 9px var(--font-mono);letter-spacing:.08em}.article__foot a{color:var(--text-muted);text-decoration:none}.article__foot a:hover{color:var(--orange)}@media(max-width:650px){.article{padding-top:45px}.article h1{font-size:clamp(45px,14vw,72px)}.article__categories{margin-top:34px}.article__image{margin-top:36px}.article__body{margin-top:45px}.prose-coreweaver{font-size:16px}.prose-coreweaver :global(h2){font-size:30px}.related>div{grid-template-columns:1fr}.article__foot{align-items:flex-start;flex-direction:column}.article__foot span{display:none}}
</style>
