---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts } from '../../lib/notion';

const posts = await getAllPosts();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Coreweaver Field Notes',
  description: 'Working notes from Coreweaver Labs on entity, evidence, distribution, measurement, and accountable operating systems.',
  url: 'https://coreweaverlabs.com/blog',
  publisher: { '@type': 'Organization', name: 'Coreweaver Labs', url: 'https://coreweaverlabs.com' },
};
---

<Layout title="Field notes — Coreweaver Labs" description="Working notes on entity, evidence, distribution, measurement, and accountable operating systems." schema={schema}>
  <section class="notes-hero"><div class="shell"><p class="eyebrow">Coreweaver / field notes</p><h1 class="display">Signals, systems,<br />and the work <em>between.</em></h1><p class="body-large">Notes from the operating layer. Each entry should be read within its own source, date, and stated scope; a published note is not a performance claim or a certification.</p></div></section>
  <section class="section notes-section"><div class="shell">
    {posts.length === 0 ? (
      <div class="notes-empty"><span>NOTES / 00</span><h2>No field notes are published<br /><em>from this source yet.</em></h2><p>The public library is intentionally quiet until a reviewed source is ready to carry a claim.</p><a class="button button--outline" href="mailto:hello@coreweaverlabs.com?subject=Coreweaver%20field%20notes">Discuss a source <span aria-hidden="true">↗</span></a></div>
    ) : (
      <div class="notes-grid">{posts.map((post, index) => (
        <article class="note-card"><div class="note-card__top"><span>NOTE / {String(index + 1).padStart(2, '0')}</span><span>{post.publishDate ? new Date(post.publishDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Undated'}</span></div>{post.heroImageUrl && <img src={post.heroImageUrl} alt="" loading={index < 3 ? 'eager' : 'lazy'} />}<div class="note-card__body"><div class="note-card__categories">{post.category.slice(0, 2).map(category => <span>{category}</span>)}</div><h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2><p>{post.metaDescription}</p><a class="note-card__link" href={`/blog/${post.slug}`}>Read the note <span aria-hidden="true">↗</span></a></div></article>
      ))}</div>
    )}
  </div></section>
</Layout>

<style>
  .notes-hero{position:relative;z-index:1;padding:clamp(88px,13vw,170px) 0 clamp(72px,10vw,128px);overflow:hidden;border-bottom:1px solid var(--line)}.notes-hero:after{position:absolute;top:-40%;right:-13%;width:60vw;height:60vw;border:1px solid rgba(20,155,162,.38);border-radius:50%;box-shadow:0 0 0 56px rgba(201,140,58,.045);content:''}.notes-hero .shell{position:relative}.notes-hero .body-large{margin:34px 0 0}.notes-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.note-card{border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(13,19,22,.28);transition:background 180ms var(--ease-out)}.note-card:hover{background:rgba(20,155,162,.1)}.note-card__top{display:flex;justify-content:space-between;gap:12px;padding:17px 18px;color:var(--text-faint);font:400 8px var(--font-mono);letter-spacing:.09em;text-transform:uppercase}.note-card img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-top:1px solid var(--line);border-bottom:1px solid var(--line);filter:saturate(.8)}.note-card__body{padding:25px 22px 26px}.note-card__categories{display:flex;gap:6px;flex-wrap:wrap}.note-card__categories span{border:1px solid rgba(201,140,58,.42);padding:3px 6px;color:var(--lime);font:400 8px var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.note-card h2{margin:42px 0 12px;font-size:26px;letter-spacing:-.055em;line-height:1.04}.note-card h2 a{text-decoration:none}.note-card h2 a:hover{color:var(--blue-bright)}.note-card p{min-height:68px;margin:0;color:var(--text-muted);font-size:13px;line-height:1.65}.note-card__link{display:inline-block;margin-top:29px;color:var(--blue-bright);font:500 9px var(--font-mono);letter-spacing:.09em;text-decoration:none;text-transform:uppercase}.note-card__link:hover{color:var(--orange)}.notes-empty{padding:80px 0;text-align:center}.notes-empty>span{color:var(--blue-bright);font:400 9px var(--font-mono);letter-spacing:.1em}.notes-empty h2{margin:18px auto;color:var(--text);font-size:clamp(36px,5vw,64px);letter-spacing:-.07em;line-height:.93}.notes-empty h2 em{color:var(--blue-bright);font-family:var(--font-serif);font-weight:500}.notes-empty p{max-width:48ch;margin:0 auto 30px;color:var(--text-muted);font-size:15px;line-height:1.7}@media(max-width:900px){.notes-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.notes-grid{grid-template-columns:1fr}.notes-hero:after{right:-50%;width:110vw;height:110vw}.note-card p{min-height:0}}
</style>
