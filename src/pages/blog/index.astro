---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts } from '../../lib/notion';

const posts = await getAllPosts();

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Coreweaver Labs Blog",
  "description": "GEO signal architecture, ARM Framework insights, and agentic growth infrastructure.",
  "url": "https://coreweaverlabs.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "Coreweaver Labs",
    "url": "https://coreweaverlabs.com"
  }
};
---

<Layout
  title="Blog — Coreweaver Labs"
  description="Signal architecture, GEO deployment, ARM Framework, and autonomous systems. The content engine for the agentic era."
  ogImage={posts[0]?.ogImageUrl ?? posts[0]?.heroImageUrl ?? 'https://lauhqmibfaglnvyhfyfz.supabase.co/storage/v1/object/public/blog-images/2026-05/arm-mandate-chain.png'}
  schema={schema}
>
  <!-- Ticker -->
  <div class="ticker-strip" aria-hidden="true">
    <div class="ticker-inner">
      {Array(4).fill(['GEO SIGNAL','ARM FRAMEWORK','AGENTIC INFRASTRUCTURE','SHARE OF MODEL','LLM CITATION','COREWEAVERLABS.COM']).flat().map(item => (
        <span class="ticker-item">{item}<span class="ticker-sep"></span></span>
      ))}
    </div>
  </div>

  <!-- Hero -->
  <section style="padding:80px 0 60px;position:relative;z-index:1;border-bottom:1px solid var(--wire);">
    <div class="container">
      <div style="opacity:0;animation:hero-in .7s var(--ease-expo) .06s forwards;">
        <div class="section-eyebrow">Content Signal</div>
        <h1 class="section-title">
          The <span class="accent">Forge.</span><br/>
          Ideas. Systems. Signal.
        </h1>
        <p style="font-size:17px;font-weight:300;color:var(--light-dim);max-width:520px;line-height:1.75;margin-bottom:32px;">
          Coreweaver Labs publishes the infrastructure layer for autonomous growth —
          GEO architecture, ARM Framework deployment, and agent-native operations.
        </p>
      </div>

      <!-- Category filters -->
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        {['All','geo','arm-framework','signal-architecture','aure','case-study','ops'].map(cat => (
          <button
            data-filter={cat}
            class="filter-btn"
            style={`font-family:var(--font-mono);font-size:9px;padding:5px 14px;border-radius:4px;letter-spacing:1.5px;text-transform:uppercase;border:1px solid var(--wire-bright);color:var(--muted);background:transparent;cursor:pointer;transition:all .2s;${cat === 'All' ? 'border-color:var(--core-soft);color:var(--core-soft);background:var(--core-dim);' : ''}`}
          >{cat}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- Post grid -->
  <section style="padding:64px 0;position:relative;z-index:1;border-top:none!important;">
    <div class="container">
      {posts.length === 0 ? (
        <div style="text-align:center;padding:80px 0;">
          <div style="font-family:var(--font-mono);font-size:10px;color:var(--muted);letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;">Forge initializing</div>
          <div style="font-family:var(--font-head);font-size:36px;color:var(--light);">Content incoming.</div>
          <p style="color:var(--muted);margin-top:12px;font-size:14px;">Agents are building. Check back soon.</p>
        </div>
      ) : (
        <div id="post-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:1px;background:var(--wire);border:1px solid var(--wire);">
          {posts.map((post, i) => (
            <article
              data-categories={JSON.stringify(post.category)}
              style="background:var(--forge-2);padding:36px 32px;position:relative;overflow:hidden;transition:background .2s;display:block;"
              onmouseover="this.style.background='var(--forge-3)'"
              onmouseout="this.style.background='var(--forge-2)'"
            >
              <!-- Role indicator -->
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                  {post.category.slice(0,2).map(cat => (
                    <span style="font-family:var(--font-mono);font-size:8.5px;padding:3px 8px;border-radius:3px;border:1px solid rgba(255,159,10,.2);color:var(--core-soft);background:var(--core-dim);text-transform:uppercase;letter-spacing:1.2px;">{cat}</span>
                  ))}
                </div>
                {post.authorAgent && (
                  <span style="font-family:var(--font-mono);font-size:8px;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase;">via {post.authorAgent}</span>
                )}
              </div>

              <!-- Hero image -->
              {post.heroImageUrl && (
                <div style="margin-bottom:20px;border-radius:8px;overflow:hidden;border:1px solid var(--wire-bright);aspect-ratio:16/9;">
                  <img
                    src={post.heroImageUrl}
                    alt={post.title}
                    loading={i < 3 ? 'eager' : 'lazy'}
                    style="width:100%;height:100%;object-fit:cover;display:block;"
                  />
                </div>
              )}

              <h2 style="font-family:var(--font-head);font-size:26px;color:var(--light);line-height:1.05;margin-bottom:10px;letter-spacing:.5px;">
                <a href={`/blog/${post.slug}`} style="color:inherit;text-decoration:none;" onmouseover="this.style.color='var(--core-soft)'" onmouseout="this.style.color='var(--light)'">{post.title}</a>
              </h2>

              <p style="font-size:13px;color:var(--muted);line-height:1.65;margin-bottom:20px;">{post.metaDescription}</p>

              <div style="display:flex;align-items:center;justify-content:space-between;padding-top:16px;border-top:1px solid var(--wire);">
                <div style="font-family:var(--font-mono);font-size:9px;color:var(--muted);letter-spacing:1px;">
                  {post.publishDate ? new Date(post.publishDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : ''}
                  {post.readingTime ? ` · ${post.readingTime}` : ''}
                </div>
                <a href={`/blog/${post.slug}`} style="font-family:var(--font-mono);font-size:9px;color:var(--core-soft);letter-spacing:1.5px;text-transform:uppercase;transition:color .2s;" onmouseover="this.style.color='var(--light)'" onmouseout="this.style.color='var(--core-soft)'">Read →</a>
              </div>

              <!-- Top accent line on hover -->
              <div class="post-accent" style="position:absolute;top:0;left:0;right:0;height:2px;background:var(--core);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease-expo);pointer-events:none;" aria-hidden="true"></div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
// Category filter
const filterBtns = document.querySelectorAll('.filter-btn');
const articles   = document.querySelectorAll('#post-grid article');

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.getAttribute('data-filter');

    filterBtns.forEach(b => {
      (b as HTMLElement).style.borderColor = 'var(--wire-bright)';
      (b as HTMLElement).style.color = 'var(--muted)';
      (b as HTMLElement).style.background = 'transparent';
    });
    (btn as HTMLElement).style.borderColor = 'var(--core-soft)';
    (btn as HTMLElement).style.color = 'var(--core-soft)';
    (btn as HTMLElement).style.background = 'var(--core-dim)';

    articles.forEach(article => {
      const cats = JSON.parse(article.getAttribute('data-categories') || '[]');
      const show = filter === 'All' || cats.includes(filter);
      (article as HTMLElement).style.display = show ? 'block' : 'none';
    });
  });
});

// Hover accent lines
articles.forEach(article => {
  const accent = article.querySelector('.post-accent') as HTMLElement;
  article.addEventListener('mouseenter', () => { if(accent) accent.style.transform = 'scaleX(1)'; });
  article.addEventListener('mouseleave', () => { if(accent) accent.style.transform = 'scaleX(0)'; });
});
</script>
