---
import Layout from '../layouts/Layout.astro';
import { faqs, network, primitives, sameAs, services, site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: site.url,
      description: site.description,
      founder: { '@type': 'Person', name: site.founder },
      sameAs,
      knowsAbout: site.topics,
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      description: site.description,
      publisher: { '@id': `${site.url}/#organization` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/#faq`,
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<Layout title={site.title} description={site.description} schema={schema}>
  <div class="ticker-strip" aria-hidden="true">
    <div class="ticker-inner">
      {Array(3).fill(['GEO MADE SIMPLE', 'AI-READABLE SYSTEMS', 'OPEN INTERFACES', 'STRUCTURED SIGNALS', 'COREWEAVER LABS']).flat().map((item) => (
        <span class="ticker-item">{item}<span class="ticker-sep"></span></span>
      ))}
    </div>
  </div>

  <section id="hero" class="hero-section" aria-labelledby="hero-title">
    <div class="container">
      <div class="section-eyebrow">Generative Engine Optimization · Open by design</div>
      <h1 id="hero-title">{site.slogan}<br /><span class="accent">Make your signal legible.</span></h1>
      <p class="hero-copy">Coreweaver Labs helps organizations publish information that is clear to people, useful to search systems, and machine-readable by any model, coding agent, or harness.</p>
      <div class="button-row">
        <a href="#services" class="btn btn-primary">See the system →</a>
        <a href="https://github.com/Coreweaver-Labs-Inc/coreweaver_" class="btn">Read the source</a>
      </div>

      <div class="stat-grid" aria-label="Coreweaver Labs principles">
        <div><strong>01</strong><span>Human-readable by default</span></div>
        <div><strong>02</strong><span>Machine-readable by contract</span></div>
        <div><strong>03</strong><span>Agent-neutral by policy</span></div>
        <div><strong>04</strong><span>Portable by architecture</span></div>
      </div>
    </div>
  </section>

  <section id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-eyebrow">The signal layer</div>
      <h2 id="services-title" class="section-title">Clarity that <span class="accent">travels.</span></h2>
      <p class="section-lede">A durable web presence should not depend on which assistant, editor, model, hosting provider, or automation harness happens to be popular this year.</p>
      <div class="card-grid">
        {services.map((service) => (
          <article class="feature-card">
            <h3>{service.name}</h3>
            <p>{service.summary}</p>
            <a href={service.href}>Explore {service.name} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="framework" aria-labelledby="framework-title">
    <div class="container">
      <div class="section-eyebrow">The ARM Framework</div>
      <h2 id="framework-title" class="section-title">Five primitives.<br /><span class="accent">No single point of lock-in.</span></h2>
      <div class="primitive-grid">
        {primitives.map(([num, title, description]) => (
          <article class="primitive-card">
            <span class="primitive-number">{num}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" aria-labelledby="faq-title">
    <div class="container narrow">
      <div class="section-eyebrow">FAQ</div>
      <h2 id="faq-title" class="section-title">Common <span class="accent">questions.</span></h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="network" aria-labelledby="network-title">
    <div class="container">
      <div class="section-eyebrow">The network</div>
      <h2 id="network-title" class="section-title">Ecosystem <span class="accent">properties.</span></h2>
      <div class="network-grid">
        {network.map(([name, domain, description]) => (
          <article class="network-card">
            <h3>{name}</h3>
            <p class="domain">{domain}</p>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="activate" class="activate-section" aria-labelledby="activate-title">
    <div class="container narrow center">
      <div class="section-eyebrow">Activate</div>
      <h2 id="activate-title" class="section-title">GEO Made <span class="accent">Simple.</span></h2>
      <p class="section-lede">Start with the public source, the machine-readable manifest, or a conversation about making your organization easier to understand.</p>
      <div class="button-row center-row">
        <a href="/agents/manifest.json" class="btn btn-primary">Open the manifest →</a>
        <a href={`mailto:${site.contact}`} class="btn">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
