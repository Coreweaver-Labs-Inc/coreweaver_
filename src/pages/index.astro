---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://coreweaverlabs.com/#org",
      "name": "Coreweaver Labs",
      "url": "https://coreweaverlabs.com",
      "logo": "https://coreweaverlabs.com/favicon.svg",
      "description": "Growth infrastructure for the agentic era. GEO signal architecture, ARM Framework for accountable AI agents, and autonomous operational systems.",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Arctura-Collective",
        "url": "https://github.com/Arctura-Collective"
      },
      "founder": {
        "@type": "Person",
        "name": "Mason Nguyen",
        "jobTitle": "CEO & Founder",
        "url": "https://coreweaverlabs.com"
      },
      "member": [
        { "@type": "Organization", "name": "AURE Swarm", "url": "https://au-re.org" },
        { "@type": "Organization", "name": "Swell Marketing", "url": "https://swellmarketing.xyz" },
        { "@type": "Organization", "name": "Arctura Network", "url": "https://arctura.network" }
      ],
      "sameAs": [
        "https://github.com/Coreweaver-Labs-Inc",
        "https://swellmarketing.xyz",
        "https://au-re.org",
        "https://arctura.network",
        "https://academy.swellmarketing.xyz"
      ],
      "knowsAbout": [
        "Generative Engine Optimization",
        "GEO Signal Architecture",
        "ARM Framework",
        "AI Agent Governance",
        "Verification-as-a-Service",
        "AURE Swarm",
        "GBrain"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://coreweaverlabs.com/#website",
      "url": "https://coreweaverlabs.com",
      "name": "Coreweaver Labs",
      "publisher": {
        "@id": "https://coreweaverlabs.com/#org"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://coreweaverlabs.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Coreweaver Labs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coreweaver Labs is a growth infrastructure provider for the agentic era, specializing in GEO signal architecture and the ARM Framework for accountable AI agents."
          }
        },
        {
          "@type": "Question",
          "name": "What is GEO Signal Architecture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO Signal Architecture is a system developed by Coreweaver Labs to optimize brand presence and citation rates in AI-generated responses."
          }
        },
        {
          "@type": "Question",
          "name": "What is the ARM Framework?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ARM Framework defines five primitives for accountable AI agent deployment: Mandate Chain, Signal Architecture, Checkpoint Recovery, Graceful Escalation, and Immutable Audit Sovereignty."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Coreweaver Labs — Growth Infrastructure for the Agentic Era"
  description="Coreweaver Labs builds GEO signal architecture, the ARM Framework for accountable AI agents, and autonomous operational systems for the AI-native era."
  schema={schema}
>
  <!-- Ticker -->
  <div class="ticker-strip" aria-hidden="true">
    <div class="ticker-inner">
      {Array(4).fill(['GEO SIGNAL ARCHITECTURE','ARM FRAMEWORK','AURE SWARM','VERIFICATION-AS-A-SERVICE','GBRAIN','SHARE OF MODEL','COREWEAVERLABS.COM']).flat().map(item => (
        <span class="ticker-item">{item}<span class="ticker-sep"></span></span>
      ))}
    </div>
  </div>

  <!-- Hero -->
  <section id="hero" style="padding:120px 0 96px;position:relative;z-index:1;">
    <div class="container">
      <div style="opacity:0;animation:hero-in .8s cubic-bezier(0.16,1,0.3,1) .08s forwards;">
        <div class="section-eyebrow">Growth Infrastructure · Agentic Era</div>
        <h1 style="font-family:var(--font-head);font-size:clamp(52px,6vw,96px);line-height:.9;letter-spacing:.5px;color:var(--light);font-weight:400;margin-bottom:28px;">
          Build agents<br/>
          that <span style="color:var(--core-soft);">can be trusted.</span>
        </h1>
        <p style="font-size:18px;font-weight:300;color:var(--light-dim);max-width:560px;line-height:1.75;margin-bottom:40px;">
          Coreweaver Labs is the infrastructure layer between "agents work" and "agents can be trusted at enterprise scale." GEO signal architecture, accountable AI deployment, and autonomous operational systems.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a href="/blog" class="btn btn-primary">Read the Forge →</a>
          <a href="#arm" class="btn">ARM Framework</a>
          <a href="#mandate" class="btn">Build with us</a>
        </div>
      </div>

      <!-- Stat strip -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1px;background:var(--wire);border:1px solid var(--wire);border-radius:10px;margin-top:80px;overflow:hidden;">
        {[
          ['88%','of AI agent pilots never reach production — governance is the #1 blocker'],
          ['63%','of enterprises cannot enforce purpose limits on their own AI agents'],
          ['$492M','AI governance spend in 2026, projected to surpass $1B by 2030'],
          ['Article 12','EU AI Act: immutable audit logs required for all high-risk AI systems'],
        ].map(([stat, desc]) => (
          <div style="padding:28px 24px;background:var(--forge-2);">
            <div style="font-family:var(--font-head);font-size:36px;color:var(--core-soft);line-height:1;margin-bottom:8px;">{stat}</div>
            <div style="font-size:12px;color:var(--muted);line-height:1.5;">{desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mandate / What we build -->
  <section id="mandate">
    <div class="container">
      <div class="section-eyebrow">The Mandate</div>
      <h2 class="section-title">Five primitives.<br/><span class="accent">One accountable agent.</span></h2>
      <p style="font-size:16px;color:var(--light-dim);max-width:540px;margin-bottom:56px;line-height:1.75;">The ARM Framework defines the infrastructure pattern for AI agents that can be deployed, audited, and trusted in production — without constant human supervision.</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1px;background:var(--wire);border:1px solid var(--wire);border-radius:10px;overflow:hidden;">
        {[
          ['01','Mandate Chain','Every agent action traces to a named human-approved directive. Cryptographically anchored. Revocable in under 60 seconds.'],
          ['02','Signal Architecture','Explicit data source hierarchy. Conflict resolution rules. Confidence thresholds. No more agents inventing decision logic.'],
          ['03','Checkpoint Recovery','Durable state serialization. Idempotency keys. Resume-not-restart on failure. No silent incompletions.'],
          ['04','Graceful Escalation','Defined triggers. Named humans. 60-second decision packages. Silence is never approval.'],
          ['05','Immutable Audit Sovereignty','Append-only Truth Ledger. Per-action granularity. Checksum-chained. No agent can modify its own history.'],
        ].map(([num, title, desc]) => (
          <div style="padding:32px 28px;background:var(--forge-2);position:relative;overflow:hidden;">
            <div style="font-family:var(--font-mono);font-size:9px;color:var(--muted);letter-spacing:2px;margin-bottom:14px;text-transform:uppercase;">{num}</div>
            <div style="font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--light);margin-bottom:10px;">{title}</div>
            <div style="font-size:13px;color:var(--muted);line-height:1.65;">{desc}</div>
            <div style="position:absolute;top:0;left:0;right:0;height:2px;background:var(--core);transform:scaleX(0);transform-origin:left;transition:transform .35s cubic-bezier(0.16,1,0.3,1);" class="card-accent" aria-hidden="true"></div>
          </div>
        ))}
      </div>

      <div style="margin-top:32px;">
        <a href="/blog/five-arm-primitives-accountable-ai-agents" class="btn">Read the full ARM Framework guide →</a>
      </div>
    </div>
  </section>

  <!-- ARM -->
  <section id="arm">
    <div class="container">
      <div class="section-eyebrow">The Stack</div>
      <h2 class="section-title">AURE · GBrain · <span class="accent">VaaS.</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
        {[
          ['AURE Swarm','16 specialized agents. One mandate. 99.97% Resonance BFT consensus. The Rena Chief Intelligence Node arbitrates every contradiction before output ships.','aure-swarm-16-agents-orchestration','/blog/aure-swarm-16-agents-orchestration'],
          ['GBrain','Open-source agentic memory layer on Postgres + pgvector. Entities, Events, Skills, Citations — persistent, sovereign, queryable. Running in production since Jan 2026.','gbrain-open-source-agentic-brain-layer','/blog/gbrain-open-source-agentic-brain-layer'],
          ['VaaS','Verification-as-a-Service. The infrastructure layer between "agents work" and "agents can be trusted at enterprise scale." BFT-attested. SHA-256 hash-chained. EU AI Act Article 12 compliant.','verification-as-a-service-ai-agents','/blog/verification-as-a-service-ai-agents'],
        ].map(([title, desc, slug, href]) => (
          <div style="background:var(--forge-2);border:1px solid var(--wire-bright);border-radius:10px;padding:32px 28px;position:relative;overflow:hidden;">
            <div style="font-family:var(--font-head);font-size:28px;color:var(--light);letter-spacing:.5px;margin-bottom:12px;">{title}</div>
            <p style="font-size:13px;color:var(--muted);line-height:1.65;margin-bottom:24px;">{desc}</p>
            <a href={href} style="font-family:var(--font-mono);font-size:10px;color:var(--core-soft);letter-spacing:1.5px;text-transform:uppercase;">Read more →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section (Visible for GEO) -->
  <section id="faq">
    <div class="container">
      <div class="section-eyebrow">FAQ</div>
      <h2 class="section-title">Common <span class="accent">Questions.</span></h2>
      <div style="display:grid;grid-template-columns:1fr;gap:24px;max-width:800px;">
        {[
          ['What is Coreweaver Labs?','Coreweaver Labs is a growth infrastructure provider for the agentic era, specializing in GEO signal architecture and the ARM Framework for accountable AI agents.'],
          ['What is GEO Signal Architecture?','GEO Signal Architecture is a system developed by Coreweaver Labs to optimize brand presence and citation rates in AI-generated responses.'],
          ['What is the ARM Framework?','The ARM Framework defines five primitives for accountable AI agent deployment: Mandate Chain, Signal Architecture, Checkpoint Recovery, Graceful Escalation, and Immutable Audit Sovereignty.'],
        ].map(([q, a]) => (
          <div style="padding:24px;background:var(--forge-2);border:1px solid var(--wire);border-radius:10px;">
            <div style="font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--light);margin-bottom:12px;">{q}</div>
            <div style="font-size:14px;color:var(--muted);line-height:1.6;">{a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Network -->
  <section id="network">
    <div class="container">
      <div class="section-eyebrow">The Network</div>
      <h2 class="section-title">Ecosystem <span class="accent">properties.</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1px;background:var(--wire);border:1px solid var(--wire);border-radius:10px;overflow:hidden;">
        {[
          ['Swell Marketing','swellmarketing.xyz','Growth execution and distribution.'],
          ['AURE','au-re.org','Architecture remediation and CMS infrastructure.'],
          ['Arctura Network','arctura.network','Ecosystem connective tissue.'],
          ['Academy','academy.swellmarketing.xyz','Operator and agent training.'],
        ].map(([name, domain, desc]) => (
          <div style="padding:28px 24px;background:var(--forge-2);">
            <div style="font-family:var(--font-display);font-size:14px;font-weight:600;color:var(--light);margin-bottom:4px;">{name}</div>
            <div style="font-family:var(--font-mono);font-size:10px;color:var(--core-soft);margin-bottom:8px;letter-spacing:.5px;">{domain}</div>
            <div style="font-size:12px;color:var(--muted);">{desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Activate CTA -->
  <section id="activate">
    <div class="container" style="text-align:center;padding:48px 0;">
      <div class="section-eyebrow" style="justify-content:center;">Activate</div>
      <h2 class="section-title">Ready to build<br/><span class="accent">accountable agents?</span></h2>
      <p style="font-size:16px;color:var(--light-dim);max-width:480px;margin:0 auto 40px;line-height:1.75;">Join the operators building on ARM Framework infrastructure. Start with the blog — or come talk to us directly.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/blog" class="btn btn-primary">Read the Forge →</a>
        <a href="mailto:hello@coreweaverlabs.com" class="btn">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>

<script>
document.querySelectorAll('.card-accent').forEach(accent => {
  const card = accent.closest('div[style*="position:relative"]');
  if(card){
    card.addEventListener('mouseenter',()=>{ accent.style.transform='scaleX(1)'; });
    card.addEventListener('mouseleave',()=>{ accent.style.transform='scaleX(0)'; });
  }
});
</script>
