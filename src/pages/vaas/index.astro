<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:           #060810;
  --bg-2:         #0c0f1a;
  --bg-3:         #121624;
  --surface:      rgba(255,255,255,0.04);
  --border:       rgba(255,255,255,0.07);
  --border-hi:    rgba(255,255,255,0.14);
  --text:         #e8eaf2;
  --text-muted:   rgba(232,234,242,0.55);
  --text-faint:   rgba(232,234,242,0.28);
  --amber:        #f59e0b;
  --amber-glow:   rgba(245,158,11,0.18);
  --amber-faint:  rgba(245,158,11,0.06);
  --green:        #10b981;
  --green-glow:   rgba(16,185,129,0.15);
  --red:          #ef4444;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.grid-overlay {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
  z-index: 0;
}

.container {
  width: 100%;
  max-width: 1160px;
  margin: 0 auto;
  padding: 0 clamp(1.25rem, 4vw, 3rem);
}

section { position: relative; z-index: 1; }


/* NAV */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 1rem 0;
  transition: background 0.3s, border-color 0.3s;
  border-bottom: 1px solid transparent;
}
nav.scrolled {
  background: rgba(6,8,16,0.92);
  backdrop-filter: blur(20px);
  border-bottom-color: var(--border);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--text);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
.nav-logo-mark {
  width: 28px; height: 28px;
  background: var(--amber);
  border-radius: 6px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.nav-logo-mark svg { width: 16px; height: 16px; }
.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  list-style: none;
}
.nav-links a {
  font-size: 0.875rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.2s;
  letter-spacing: 0.01em;
}
.nav-links a:hover { color: var(--text); }
.btn-nav {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--bg);
  background: var(--amber);
  border: none;
  padding: 0.5rem 1.25rem;
  border-radius: 6px;
  cursor: pointer;
  text-decoration: none;
  letter-spacing: -0.01em;
  transition: filter 0.2s, transform 0.15s;
}
.btn-nav:hover { filter: brightness(1.1); transform: translateY(-1px); }


/* HERO */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8rem 0 6rem;
  position: relative;
  overflow: hidden;
}
.hero-glow {
  position: absolute;
  top: -200px; left: 50%;
  transform: translateX(-50%);
  width: 900px; height: 600px;
  background: radial-gradient(ellipse 70% 50% at 50% 40%,
    rgba(245,158,11,0.10) 0%, transparent 70%);
  pointer-events: none;
}
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Space Mono', monospace;
  font-size: 0.75rem;
  color: var(--amber);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 1.75rem;
  opacity: 0;
  animation: fadeUp 0.6s ease both 0.1s;
}
.tag-dot {
  width: 6px; height: 6px;
  background: var(--amber);
  border-radius: 50%;
  animation: pulse 2s ease infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

.hero-headline {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(3rem, 7vw + 1rem, 7.5rem);
  font-weight: 700;
  line-height: 0.95;
  letter-spacing: -0.04em;
  margin-bottom: 2rem;
  max-width: 14ch;
  opacity: 0;
  animation: fadeUp 0.9s ease both 0.2s;
}
.hero-headline .line-1 { color: var(--text); display: block; }
.hero-headline .line-2 {
  display: block;
  background: linear-gradient(135deg, var(--amber) 0%, #fbbf24 50%, #f97316 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-headline .line-3 {
  color: var(--text-faint);
  font-weight: 300;
  display: block;
}

.hero-sub {
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  color: var(--text-muted);
  max-width: 52ch;
  line-height: 1.65;
  margin-bottom: 2.5rem;
  opacity: 0;
  animation: fadeUp 0.9s ease both 0.35s;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-bottom: 4rem;
  opacity: 0;
  animation: fadeUp 0.9s ease both 0.45s;
}
.btn-primary {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 600;
  font-size: 1rem;
  letter-spacing: -0.02em;
  color: #060810;
  background: var(--amber);
  border: none;
  padding: 0.85rem 2rem;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: filter 0.2s, transform 0.15s;
}
.btn-primary:hover { filter: brightness(1.08); transform: translateY(-2px); }
.btn-ghost {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 500;
  font-size: 0.95rem;
  letter-spacing: -0.01em;
  color: var(--text-muted);
  background: transparent;
  border: 1px solid var(--border-hi);
  padding: 0.85rem 1.75rem;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
  transition: color 0.2s, border-color 0.2s;
}
.btn-ghost:hover { color: var(--text); border-color: rgba(255,255,255,0.3); }

.hero-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 2.5rem;
  opacity: 0;
  animation: fadeUp 0.9s ease both 0.55s;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}
.stat-item {}
.stat-num {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--text);
  line-height: 1;
  margin-bottom: 0.25rem;
}
.stat-num span { color: var(--amber); }
.stat-label {
  font-size: 0.8125rem;
  color: var(--text-faint);
  letter-spacing: 0.02em;
}

/* STATUS TICKER */
.compliance-ticker {
  position: absolute;
  right: 0; top: 50%;
  transform: translateY(-45%);
  width: min(420px, 42vw);
  opacity: 0;
  animation: fadeUp 1s ease both 0.6s;
}
@media (max-width: 900px) { .compliance-ticker { display: none; } }

.ticker-card {
  background: var(--bg-2);
  border: 1px solid var(--border-hi);
  border-radius: 16px;
  padding: 1.5rem;
  font-family: 'Space Mono', monospace;
  font-size: 0.75rem;
}
.ticker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
  color: var(--text-muted);
}
.ticker-title {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 600;
  font-size: 0.8125rem;
  color: var(--text);
  letter-spacing: -0.01em;
}
.ticker-live {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--green);
  font-size: 0.6875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.live-dot {
  width: 5px; height: 5px;
  background: var(--green);
  border-radius: 50%;
  animation: pulse 1.5s ease infinite;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 0.75rem;
  border-radius: 8px;
  margin-bottom: 0.4rem;
  transition: background 0.2s;
}
.check-row.pass { background: rgba(16,185,129,0.07); }
.check-row.fail { background: rgba(239,68,68,0.07); }
.check-row.pending { background: rgba(245,158,11,0.07); }
.check-icon { font-size: 0.8rem; flex-shrink: 0; width: 16px; text-align: center; }
.check-icon.pass { color: var(--green); }
.check-icon.fail { color: var(--red); }
.check-icon.pending { color: var(--amber); }
.check-label { flex: 1; color: var(--text-muted); letter-spacing: 0.01em; }
.check-badge {
  font-size: 0.625rem;
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  letter-spacing: 0.06em;
  font-weight: 600;
  text-transform: uppercase;
}
.badge-pass { background: rgba(16,185,129,0.15); color: var(--green); }
.badge-fail { background: rgba(239,68,68,0.12); color: var(--red); }
.badge-pending { background: rgba(245,158,11,0.12); color: var(--amber); }

.ticker-footer {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-faint);
  font-size: 0.6875rem;
}
.audit-hash { color: var(--amber); font-size: 0.65rem; letter-spacing: 0.04em; }

/* PROBLEM SECTION */
.section-eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--amber);
  margin-bottom: 1rem;
}
.section-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(2rem, 3.5vw, 3.25rem);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.1;
  color: var(--text);
  margin-bottom: 1.25rem;
}
.section-body {
  font-size: 1.0625rem;
  color: var(--text-muted);
  max-width: 56ch;
  line-height: 1.7;
}

.problem-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  margin-top: 3.5rem;
}
.problem-cell {
  background: var(--bg-2);
  padding: 2rem 2rem 2.25rem;
  transition: background 0.3s;
}
.problem-cell:hover { background: var(--bg-3); }
.problem-num {
  font-family: 'Space Mono', monospace;
  font-size: 0.6875rem;
  color: var(--amber);
  letter-spacing: 0.1em;
  margin-bottom: 1.25rem;
  opacity: 0.7;
}
.problem-icon {
  font-size: 1.75rem;
  margin-bottom: 1rem;
}
.problem-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.125rem;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--text);
  margin-bottom: 0.6rem;
  line-height: 1.2;
}
.problem-desc {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.65;
}


/* HOW IT WORKS */
.hiw-wrap {
  padding: clamp(5rem, 10vw, 9rem) 0;
  background: linear-gradient(180deg, transparent 0%, rgba(245,158,11,0.025) 50%, transparent 100%);
}
.hiw-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
  margin-top: 4rem;
}
@media (max-width: 768px) { .hiw-grid { grid-template-columns: 1fr; gap: 3rem; } }

.steps {}
.step {
  display: flex;
  gap: 1.5rem;
  margin-bottom: 2.5rem;
  opacity: 0;
  transition: opacity 0.6s ease, transform 0.6s ease;
  transform: translateX(-20px);
}
.step.visible { opacity: 1; transform: none; }
.step-num-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}
.step-num {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: var(--amber-faint);
  border: 1px solid rgba(245,158,11,0.3);
  display: grid;
  place-items: center;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--amber);
  flex-shrink: 0;
}
.step-line {
  width: 1px;
  flex: 1;
  min-height: 32px;
  background: linear-gradient(180deg, rgba(245,158,11,0.3), transparent);
  margin-top: 4px;
}
.step-content { padding-top: 0.4rem; }
.step-title {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 600;
  font-size: 1.0625rem;
  letter-spacing: -0.02em;
  color: var(--text);
  margin-bottom: 0.4rem;
}
.step-desc {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.65;
}

/* ARM PRIMITIVES CARD */
.primitives-card {
  background: var(--bg-2);
  border: 1px solid var(--border-hi);
  border-radius: 16px;
  padding: 2rem;
  position: sticky;
  top: 6rem;
}
.prim-header {
  margin-bottom: 1.5rem;
}
.prim-eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 0.625rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 0.4rem;
}
.prim-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--text);
}
.prim-item {
  display: flex;
  align-items: flex-start;
  gap: 0.875rem;
  padding: 0.9rem 0;
  border-bottom: 1px solid var(--border);
}
.prim-item:last-child { border-bottom: none; }
.prim-indicator {
  width: 28px; height: 28px;
  border-radius: 6px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  font-size: 0.7rem;
  font-family: 'Space Mono', monospace;
  font-weight: 700;
}
.prim-p1 { background: rgba(245,158,11,0.12); color: var(--amber); }
.prim-p2 { background: rgba(99,102,241,0.12); color: #818cf8; }
.prim-p3 { background: rgba(16,185,129,0.12); color: var(--green); }
.prim-p4 { background: rgba(236,72,153,0.1); color: #f472b6; }
.prim-p5 { background: rgba(59,130,246,0.1); color: #60a5fa; }
.prim-name {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--text);
  letter-spacing: -0.01em;
  margin-bottom: 0.2rem;
}
.prim-role {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.5;
}
.prim-vaas-tag {
  margin-left: auto;
  font-size: 0.6rem;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  background: var(--amber-faint);
  border: 1px solid rgba(245,158,11,0.2);
  color: var(--amber);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-family: 'Space Mono', monospace;
  white-space: nowrap;
  flex-shrink: 0;
}


/* FAQ */
.faq-section {
  padding: clamp(5rem, 10vw, 9rem) 0;
}
.faq-grid {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 5rem;
  align-items: start;
  margin-top: 3rem;
}
@media (max-width: 768px) { .faq-grid { grid-template-columns: 1fr; gap: 3rem; } }

.faq-list { list-style: none; }
.faq-item {
  border-bottom: 1px solid var(--border);
  opacity: 0;
  transition: opacity 0.5s ease;
}
.faq-item.visible { opacity: 1; }
.faq-q {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 0;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 600;
  font-size: 0.9375rem;
  color: var(--text);
  letter-spacing: -0.015em;
  cursor: pointer;
  background: none;
  border: none;
  text-align: left;
  transition: color 0.2s;
  gap: 1rem;
}
.faq-q:hover { color: var(--amber); }
.faq-caret {
  flex-shrink: 0;
  width: 18px; height: 18px;
  border: 1px solid var(--border-hi);
  border-radius: 4px;
  display: grid;
  place-items: center;
  color: var(--text-muted);
  transition: transform 0.3s, background 0.2s;
  font-size: 0.75rem;
}
.faq-item.open .faq-caret { transform: rotate(45deg); background: var(--amber-faint); color: var(--amber); border-color: rgba(245,158,11,0.3); }
.faq-a {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.3s ease;
  padding-bottom: 0;
}
.faq-item.open .faq-a { max-height: 400px; padding-bottom: 1.25rem; }


/* CTA SECTION */
.cta-section {
  padding: clamp(5rem, 10vw, 8rem) 0;
  overflow: hidden;
}
.cta-card {
  border: 1px solid var(--border-hi);
  border-radius: 20px;
