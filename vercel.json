{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/agents/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "redirects": [
    { "source": "/arm", "destination": "/framework/arm/", "permanent": true },
    { "source": "/geo", "destination": "/geo/", "permanent": true },
    { "source": "/vaas", "destination": "/vaas/", "permanent": false },
    { "source": "/blog/verification-as-a-service-ai-agents", "destination": "/vaas/", "permanent": true },
    { "source": "/blog/agentic-ai-governance-framework", "destination": "/blog", "permanent": true },
    { "source": "/blog/bft-ai-verification-enterprise", "destination": "/blog", "permanent": true },
    { "source": "/blog/csrd-carbon-credit-verification", "destination": "/blog", "permanent": true }
  ]
}
